# ============================================================================
# Emailibrium Backend — Rust (Cargo)
# ============================================================================
#
# Quick Start:
#   just build     - Build the backend
#   just test      - Run all tests
#   just dev       - Start dev server
#   just bench     - Run benchmarks
#
#   just --list    - Show every recipe, grouped by category
# ============================================================================

set shell := ["bash", "-cu"]

CARGO := "cargo"
export CARGO_INCREMENTAL := "1"

# Model id for `download-model`. Also settable as `just MODEL=<id> download-model`.
MODEL := ""

BOLD   := `tput bold 2>/dev/null || echo ''`
GREEN  := `tput setaf 2 2>/dev/null || echo ''`
YELLOW := `tput setaf 3 2>/dev/null || echo ''`
BLUE   := `tput setaf 4 2>/dev/null || echo ''`
RED    := `tput setaf 1 2>/dev/null || echo ''`
RESET  := `tput sgr0 2>/dev/null || echo ''`

# ============================================================================
# Default Recipe (just runs the first recipe when given no arguments)
# ============================================================================

