// markdownlint-cli2 configuration
// Ignore patterns for directories that should not be linted
{
  "ignores": [
    ".claude/**",
    ".claude-flow/**",
    ".agentic-qe/**",
    // Same class as the three above: tool-generated, git-ignored agent scaffolding.
    // Without these, `just lint` fails on a developer's machine purely because a
    // local tool wrote docs there — files CI never sees, so the check was red
    // locally and green in CI for the same commit.
    ".agents/**",
    ".codex/**",
    ".swarm/**",
    ".beads/**",
    "**/node_modules/**",
    "**/target/**",
    "ruvector/**",
    ".claude/worktrees/**",
    // Untracked personal working note (starts with a blockquote, so MD041 can't
    // pass without altering its content). CI never sees it; without this ignore,
    // `just lint` is red locally and green in CI for the same commit.
    "docs/Connect Multiple Gmails*",
  ],
}
