# Copy to .env.integration (gitignored) and chmod 600 .env.integration.
# Node loads literal dotenv values; existing shell/CI environment takes precedence.
# Never put production mailbox credentials here. Leave unused providers empty.

# Optional: a disposable local test database. The postgres mode runs migrations
# and writes test rows. Create the isolated database described in the test guide.
EMAILIBRIUM_TEST_PG_URL=

# Dedicated Gmail test account, approved for Gmail API read-only access.
EMAILIBRIUM_TEST_GOOGLE_CLIENT_ID=
EMAILIBRIUM_TEST_GOOGLE_CLIENT_SECRET=
EMAILIBRIUM_TEST_GOOGLE_REFRESH_TOKEN=
EMAILIBRIUM_TEST_GOOGLE_EXPECTED_EMAIL=

# Dedicated Outlook test account, with delegated User.Read / MailboxSettings.Read and
# offline_access. These are separate from the application's production secrets.
EMAILIBRIUM_TEST_MICROSOFT_CLIENT_ID=
EMAILIBRIUM_TEST_MICROSOFT_CLIENT_SECRET=
EMAILIBRIUM_TEST_MICROSOFT_REFRESH_TOKEN=
EMAILIBRIUM_TEST_MICROSOFT_EXPECTED_EMAIL=
# Optional: tenant GUID, common, organizations, or consumers.
EMAILIBRIUM_TEST_MICROSOFT_TENANT_ID=common
